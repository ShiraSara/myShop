# ─────────────────────────────────────────────────────────────
#  שוק — Environment variables
#  Copy to .env (never commit .env) and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, OpenGraph, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# Secret used to sign/derive tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Image storage ────────────────────────────────────────────
# "local" stores files on disk (dev / single server).
# "s3" works with any S3-compatible storage: AWS S3, Cloudflare R2,
# Supabase Storage (S3 endpoint), MinIO, DigitalOcean Spaces...
STORAGE_DRIVER=local
# Directory for the local driver (relative to the project root)
STORAGE_LOCAL_DIR=storage/uploads

# S3-compatible settings (only when STORAGE_DRIVER=s3)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=
# "true" for MinIO / some providers that require path-style URLs
STORAGE_FORCE_PATH_STYLE=false

# ── Email (password reset) ───────────────────────────────────
# "console" prints emails to the server log (dev). "resend" sends via https://resend.com
MAIL_DRIVER=console
MAIL_FROM="שוק <no-reply@example.com>"
RESEND_API_KEY=

# ── Seed ─────────────────────────────────────────────────────
# Password given to all demo users created by `npm run db:seed`
SEED_USER_PASSWORD=Password123!
